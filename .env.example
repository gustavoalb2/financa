# Local development defaults
DJANGO_SECRET_KEY=gere-uma-chave-secreta-diferente-em-cada-ambiente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Cole aqui a connection string do Neon apenas no arquivo .env local.
# No Vercel, cadastre DATABASE_URL nas Environment Variables.
# DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require
